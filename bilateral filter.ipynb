   "source": [
    "# Bilateral Filter\n",
    "\n",
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img = cv2.imread(\"wallp.png\")\n",
    "\n",
    "bilateral = cv2.bilateralFilter(img, 9, 75, 75)\n",
    "\n",
    "bilateral = cv2.cvtColor(bilateral, cv2.COLOR_BGR2RGB)\n",
    "plt.imshow(bilateral)\n",
    "plt.title(\"Bilateral Filter\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
  },
