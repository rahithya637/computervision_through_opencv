   "source": [
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img = cv2.imread(\"wallp.png\")\n",
    "\n",
    "gaussian = cv2.GaussianBlur(img, (7,7), 0)\n",
    "\n",
    "plt.imshow(cv2.cvtColor(gaussian, cv2.COLOR_BGR2RGB))\n",
    "plt.title(\"Gaussian Blur\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
