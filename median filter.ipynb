   "source": [
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img = cv2.imread(\"wallp.png\")\n",
    "\n",
    "median = cv2.medianBlur(img, 5)\n",
    "\n",
    "plt.imshow(cv2.cvtColor(median, cv2.COLOR_BGR2RGB))\n",
    "plt.title(\"Median Filter\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
